<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!--
    Renomeia a coluna max_pages para max_comments na entidade Parameter.
    O campo passou a representar o número máximo de comentários por URL (para
    todas as fontes), em vez de nº de páginas do Reclame Aqui.
  -->
  <changeSet id="20260815120000-1" author="ows.daniel">
    <renameColumn tableName="parameter"
                  oldColumnName="max_pages"
                  newColumnName="max_comments"
                  columnDataType="bigint"/>
  </changeSet>
</databaseChangeLog>
